// ArtLight's USB/IP helper is reached by the ArtLight server, which runs as the
// system account "artlight" inside a systemd SYSTEM unit.
//
// The action this pairs with (org.artlight.input-service.policy) is deliberately
// allow_any=no, allow_inactive=no, allow_active=yes. That shape is correct for
// ArtMoon, whose helper is called from a GUI sitting in the user's active session.
// It can NEVER fit ArtLight: a system unit has no session, so polkit's subject is
// neither "active" nor "inactive" and the action refuses the server that owns the
// helper. Measured on the z13, the refusal reads:
//
//     Error executing command as another user: Not authorized
//
// The action is right and must not be widened. This rule is what closes the gap:
// it admits exactly one account - the one the server runs as - and leaves
// allow_any and allow_inactive saying "no" for every other subject, so a remote
// session and a session nobody is sitting at are still refused. That distinction
// is the whole reason this is done with polkit rather than with a setuid bit.
//
// pkexec's own exec.path annotation still pins the action to the one binary at
// /usr/libexec/vibeshine/artlight-input-service, so this grants no program choice.
polkit.addRule(function(action, subject) {
    if (action.id == "org.artlight.input-service.attach" &&
        subject.user == "artlight") {
        return polkit.Result.YES;
    }
});
