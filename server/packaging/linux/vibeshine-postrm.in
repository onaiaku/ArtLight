#!/bin/sh

# Ordinary removal and upgrades deliberately preserve the administrator's
# machine policy and the service-owned pairings/settings. Debian's explicit
# purge operation revokes them. Other package formats expose the equivalent
# deliberate operation through `artlight-machine-host reset` before removal.
[ "${1:-}" = purge ] || exit 0

for artlight_file in \
  /etc/artlight/machine.conf \
  /etc/artlight/prelogin.conf \
  /etc/artlight/session-commands; do
  rm -f -- "$artlight_file" || exit 1
done
rmdir -- /etc/artlight 2>/dev/null || true

artlight_profile=/var/lib/artlight
if [ -L "$artlight_profile" ]; then
  rm -f -- "$artlight_profile" || exit 1
elif [ -d "$artlight_profile" ]; then
  if mountpoint -q -- "$artlight_profile"; then
    echo "error: refusing to purge mounted machine state: $artlight_profile" >&2
    exit 1
  fi
  if [ "$(stat -c '%U:%G:%a:%F' -- /var/lib 2>/dev/null)" != 'root:root:755:directory' ]; then
    echo 'error: refusing to purge machine state beneath an unsafe /var/lib.' >&2
    exit 1
  fi
  rm -rf --one-file-system -- "$artlight_profile" || exit 1
elif [ -e "$artlight_profile" ]; then
  rm -f -- "$artlight_profile" || exit 1
fi

if [ -e "$artlight_profile" ] || [ -L "$artlight_profile" ]; then
  echo 'error: ArtLight machine state remains after purge.' >&2
  exit 1
fi

echo 'Removed ArtLight machine policy, credentials, pairings, and shared settings.'
