# The machine-scoped ArtLight host runs as the unprivileged "artlight"
# account. Grant it virtual input devices through a dedicated group instead of
# the broad "input" group, which would also expose every physical input event.
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="artlight-uinput", MODE="0660", OPTIONS+="static_node=uinput", TAG+="uaccess"
KERNEL=="uhid", SUBSYSTEM=="misc", GROUP="artlight-uinput", MODE="0660", OPTIONS+="static_node=uhid", TAG+="uaccess"
KERNEL=="vibeshine-ds5", SUBSYSTEM=="misc", GROUP="artlight-uinput", MODE="0660", TAG+="uaccess"
