[Unit]
Description=ArtLight machine streaming host
Documentation=https://github.com/onaiaku/ArtLight
# The controller owns ordered cleanup through ExecStopPost. Binding this unit
# directly to the controller would queue a concurrent stop and bypass that
# close-admission, drain-host, drain-broker sequence.
Requires=artlight-session-exec.socket artlight-input-service.socket
Wants=vibeshine-vkms.service
After=artlight-session-controller.service artlight-session-exec.socket artlight-input-service.socket vibeshine-vkms.service
ConditionPathExists=/run/artlight/session.env
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=all
User=artlight
Group=artlight
SupplementaryGroups=video render artlight-uinput vibeshine-vkms
StateDirectory=artlight
StateDirectoryMode=0700
RuntimeDirectory=artlight/host
RuntimeDirectoryMode=0700
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_NICE
AmbientCapabilities=
# The capability-free supervisor must be able to exec the private +p host.
# The host enters with E/I/A empty and sets NoNewPrivileges in the literal
# first Linux statement of main(), before configuration or logging.
NoNewPrivileges=no
ExecStart=/usr/libexec/vibeshine/artlight-machine-host run
Restart=no
# Signal the supervisor, which forwards once to the GPU-owning host. Its
# broker clients must survive until capture drains and the host closes them.
KillMode=mixed
# A stuck GPU teardown must leave this unit deactivating and block rebinding;
# killing the process tree would strand imported DRM/NVENC resources.
SendSIGKILL=no
TimeoutStartSec=45
TimeoutStopSec=20
MemoryMax=2G
TasksMax=512
UMask=0077
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-nvidia rw
DeviceAllow=char-nvidia-modeset rw
DeviceAllow=char-nvidia-uvm rw
DeviceAllow=char-nvidia-caps r
DeviceAllow=/dev/uinput rw
DeviceAllow=/dev/uhid rw
DeviceAllow=/dev/vibeshine-ds5 rw
# The quit combo reads the keyboard a client shared in, so the sandbox has to let it at the
# input nodes. DevicePolicy=closed denies everything not named above, and that denial arrives
# as EPERM rather than EACCES - which makes it invisible to every check that is not this line:
# the nodes are 0660, the host is in artlight-uinput, a root shell opens them all day, and the
# reader's own open failure is deliberately silent. Without this the watcher skips every
# imported keyboard it is handed and logs "no keyboard has been shared in yet" while one is
# attached.
#
# Read only, because the watcher opens the node O_RDONLY and never writes to it. This is also
# not the only wall: the machine's own keyboards stay root:input, and the host is not in input,
# so ownership still refuses them even with this allowed. Measured on a real machine - a reader
# run inside this unit's exact DevicePolicy=closed allow list reported "Operation not permitted"
# on all five imported nodes, and five clean opens the moment char-input was added.
DeviceAllow=char-input r
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @debug @module @mount @reboot @swap
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
