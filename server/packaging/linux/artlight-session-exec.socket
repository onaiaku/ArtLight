[Unit]
Description=ArtLight session execution broker socket
Documentation=https://github.com/onaiaku/ArtLight
After=artlight-session-controller.service
# Keep admission alive until the GPU host has drained every already-accepted
# compositor request during machine shutdown. Controller cleanup stops this
# socket explicitly before requesting the host stop on manual transitions.
Before=artlight.service

[Socket]
ListenSequentialPacket=/run/artlight/session-broker.sock
SocketMode=0660
SocketUser=root
SocketGroup=artlight
DirectoryMode=0755
Accept=yes
RemoveOnStop=yes
Backlog=16
MaxConnections=32
MaxConnectionsPerSource=16
